# Local development configuration. Copy to .env:  cp .env.example .env
#
# Every secret here is required with no built-in default. That is deliberate: the
# previous version shipped a hardcoded JWT signing key and admin password as fallbacks,
# so a deployment that forgot to set them came up with publicly-known credentials and no
# warning. The server now refuses to start instead.
#
# The values below are fine for localhost and must be replaced for anything reachable
# from a network.

PORT=8080

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=drs_db
DB_SSLMODE=disable

# Must be at least 32 characters. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=local-development-only-jwt-secret-change-me-32chars

# Explicit origin allowlist. Comma-separated; the Vite dev server runs on :3000.
CORS_ORIGINS=http://localhost:3000

# How often an agent must send a heartbeat. The socket read deadline is three times
# this, so it also decides how quickly a powered-off device is noticed.
HEARTBEAT_SECONDS=10

# What the backend asks agents to capture at. Lower the width or the frame rate if the
# endpoint CPU cannot keep up; raise them if it has headroom. The agent clamps both, and
# logs what it actually encoded at.
SESSION_FPS=24
SESSION_MAX_WIDTH=1280

# Where the agent binaries staged for download live: drs-agent.exe and drs-agent.apk.
# Setting this turns on zero-touch enrollment — the backend serves the Windows agent with
# this server's address and the invite's token appended to it, so the recipient runs the
# file and nothing else. Leave it empty and the enroll page says no agent is published
# rather than offering a download that cannot work.
#
# For local development, point it at the repo's own directory:
# AGENT_BINARY_DIR=../deploy/downloads
AGENT_BINARY_DIR=

# The origin this server is reachable at. Normally derived per request from
# X-Forwarded-Proto / X-Forwarded-Host / Host, which is right behind nginx and right in
# most dev setups. Set it only when that derivation is wrong: it is baked into downloaded
# agents, and a wrong value produces agents that can never connect, on machines nobody is
# watching.
# PUBLIC_BASE_URL=https://drs.example.com

# NAT traversal. STUN alone is enough on a flat local network or open home network.
STUN_URLS=stun:stun.l.google.com:19302

# Uncomment to enable the media relay. Needed when peers cannot reach each other
# directly, which is common behind corporate NAT and firewalls. The relay is this
# project's own binary; run it alongside the server with:  go run ./cmd/turnserver
# (it reads this same file, so the credentials cannot disagree).
#
# To test forced relay locally, uncomment all four of these plus FORCE_TURN_RELAY below
# and use 127.0.0.1 as the public IP. The viewer badge should then read
# "Relayed (TURN)" instead of "Direct (P2P)", which is the proof that media is no
# longer going peer-to-peer.
# TURN_PUBLIC_IP=127.0.0.1
# TURN_SHARED_SECRET=generate-with-openssl-rand-hex-32
# TURN_PORT=3478
# TURN_REALM=drs

# The first super admin, created only when no super admin exists yet.
DEFAULT_SUPERADMIN_EMAIL=admin@drs.local
DEFAULT_SUPERADMIN_PASSWORD=ChangeMe-Local-Dev-2026

# Force ALL session media through the TURN relay instead of only using it as a fallback.
# Requires TURN_PUBLIC_IP and TURN_SHARED_SECRET; the server refuses to start otherwise,
# because forcing relay with no relay configured means no session can ever connect.
# FORCE_TURN_RELAY=true
