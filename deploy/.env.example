# Production configuration. Copy to .env next to docker-compose.yml and fill it in.
#
# docker compose fails to start if any of the required values below is missing, rather
# than substituting a default that would be identical on every deployment.

# --- Required ------------------------------------------------------------------------

# openssl rand -hex 32
DB_PASSWORD=

# openssl rand -hex 32   (must be at least 32 characters)
JWT_SECRET=

# The exact origin the portal is served from. Not a wildcard: combined with credentials
# a reflected origin would give every website on the internet authenticated API access.
CORS_ORIGINS=https://drs.example.com

# First super admin login. Change it after the first sign-in.
ADMIN_EMAIL=admin@drs.example.com
ADMIN_PASSWORD=

# --- Optional ------------------------------------------------------------------------

HEARTBEAT_SECONDS=10
STUN_URLS=stun:stun.l.google.com:19302

# What the backend asks agents to capture at. Lower the width or the frame rate if the
# endpoint CPU cannot keep up; raise them if it has headroom. The agent clamps both, and
# logs what it actually encoded at.
SESSION_FPS=24
SESSION_MAX_WIDTH=1280

# --- Media relay ---------------------------------------------------------------------
#
# Required for a deployment that has to reach devices on networks you do not control,
# which is the normal case: without a relay, any session where neither peer can reach
# the other directly simply fails, with no fallback (SDS 3.1).
#
# The relay is this project's own binary (backend/cmd/turnserver), built into the same
# image as the API server so both share one definition of the credential format. Start
# it with:  docker compose --profile turn up -d
#
# TURN_PUBLIC_IP must be the VPS's public IP, as an address and not a hostname: it is
# what the relay puts in the candidates it hands out, so a wrong value fails only for
# remote peers and looks exactly like a firewall problem.
TURN_PUBLIC_IP=
# openssl rand -hex 32
TURN_SHARED_SECRET=
TURN_PORT=3478
TURN_REALM=drs

# One relay port is used per allocation. Widen this range if you expect more than a few
# dozen concurrent sessions, and open the same range on the firewall.
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# Force ALL session media through the relay instead of connecting peers directly.
#
# Set this to true for the deployment described in the SRS: every session then travels
# agent -> server -> browser, so connectivity never depends on either endpoint's NAT and
# no device needs a public address or an inbound port. The cost is bandwidth — roughly
# 7-8 Mbps of VPS traffic per concurrent session at the default encode settings, so
# check the host's allowance before scaling.
#
# Requires TURN_PUBLIC_IP and TURN_SHARED_SECRET; the backend refuses to start otherwise,
# because forcing relay with no relay means no session can ever connect.
FORCE_TURN_RELAY=false

# Firewall on the VPS must allow:
#   80, 443            TCP   portal and API
#   3478               UDP + TCP   relay control
#   49160-49200        UDP   relay media (match TURN_MIN_PORT/TURN_MAX_PORT)
